NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Must use a domain verified in Resend; this is not your Vercel preview URL.
RESEND_FROM_EMAIL=hello@your-domain.com
RESEND_FROM_NAME=Glimms
# Optional but recommended mailbox for replies.
RESEND_REPLY_TO=hello@your-domain.com
# Use your Vercel production URL until you connect a custom domain.
NEXT_PUBLIC_APP_URL=https://glimms-waitlist.vercel.app
NEXT_PUBLIC_BASE_COUNT=2847
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=glimms.ai

# Abuse prevention — required in production
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Lifecycle automation
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
CRON_SECRET=use-a-long-random-secret
