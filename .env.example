# ── Public env (prefixed NEXT_PUBLIC_ — bundled to client, safe to expose) ──
# These are intentionally public and appear in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://glimms.ai
NEXT_PUBLIC_BASE_COUNT=2847
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=glimms.ai

# ── Server-only secrets (NEVER prefix with NEXT_PUBLIC_ — server only) ──
# Never commit real values. Set these in Vercel / Netlify dashboard or .env.local (gitignored).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@glimms.ai
RESEND_FROM_NAME=Glimms
